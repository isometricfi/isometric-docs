{
  "$schema": "https://holocron.so/docs.json",
  "name": "Isometric",
  "description": "How to trade with leverage, predict, and write on Isometric.",
  "favicon": "/favicon.svg",
  "logo": {
    "light": "/logo-light.svg",
    "dark": "/logo-dark.svg",
  },
  "colors": {
    "primary": "#316ce8",
    "light": "#316ce8",
    "dark": "#6f93ff",
  },
  "appearance": {
    "default": "light",
  },
  "assistant": {
    "enabled": false,
  },
  "fonts": {
    "family": "Inter",
  },
  "icons": {
    "library": "lucide",
  },
  "navbar": {
    "primary": {
      "type": "button",
      "label": "Open the app",
      "href": "https://app.isometric.fi",
    },
  },
  "navigation": {
    "versions": [
      {
        "version": "English",
        "lang": "en",
        "default": true,
        "tabs": [
          {
            "tab": "Leverage",
            "icon": "lucide:trending-up",
            "groups": [
              {
                "group": "Start here",
                "icon": "lucide:compass",
                "pages": ["index", "trade/quickstart", "trade/pay-and-swap", "markets"],
              },
              {
                "group": "Trading",
                "icon": "lucide:sliders-horizontal",
                "pages": [
                  "trade/reading-the-chart",
                  "trade/leverage",
                  "trade/expiry-and-settlement",
                  "trade/payouts-and-claims",
                  "trade/fees",
                ],
              },
              {
                "group": "Compare and risks",
                "icon": "lucide:scale",
                "pages": [
                  "trade/perps-vs-isometric",
                  "trade/prediction-markets-vs-isometric",
                  "trade/risks",
                ],
              },
              {
                "group": "Under the hood",
                "icon": "lucide:cog",
                "pages": ["trade/how-it-works"],
              },
            ],
          },
          {
            "tab": "Predict",
            "icon": "lucide:target",
            "groups": [
              {
                "group": "Predicting",
                "icon": "lucide:target",
                "pages": ["predict/quickstart", "predict/how-it-pays", "predict/fees"],
              },
              {
                "group": "Compare and risks",
                "icon": "lucide:scale",
                "pages": ["predict/prediction-markets-vs-isometric", "predict/risks"],
              },
            ],
          },
          {
            "tab": "Write",
            "icon": "lucide:pen-line",
            "groups": [
              {
                "group": "Writing",
                "icon": "lucide:pen-line",
                "pages": ["write/writers"],
              },
            ],
          },
          {
            "tab": "Reference",
            "icon": "lucide:list-tree",
            "groups": [
              {
                "group": "Reference",
                "icon": "lucide:list-tree",
                "pages": ["glossary", "faq"],
              },
            ],
          },
        ],
      },
